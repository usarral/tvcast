# tvcast without a desktop: mpv draws straight to the TV through DRM/KMS.
# Install (see docs/INSTALL.md):
#   sudo cp tvcast.service /etc/systemd/system/tvcast.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tvcast
[Unit]
Description=tvcast - photos from the phone to the TV
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
User=tvcast
Group=tvcast
SupplementaryGroups=video render audio
StateDirectory=tvcast
# TVCAST_WIFI_SSID and TVCAST_WIFI_PASS (for the wifi QR on the TV), and
# TVCAST_LANG=es for a Spanish TV screen (default en). Phones see the web page
# in their own language when it is supported.
EnvironmentFile=-/etc/tvcast.env
ExecStart=/usr/local/bin/tvcast -addr :80 -data /var/lib/tvcast -iface wlan0 -display mpv -mpv-socket /run/tvcast/mpv.sock -mpv-args "--vo=gpu --gpu-context=drm --drm-mode=1920x1080"
RuntimeDirectory=tvcast
# Port 80 without root (so the address is just http://10.42.0.1)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
