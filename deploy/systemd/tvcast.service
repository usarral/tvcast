# tvcast sin entorno gráfico: mpv pinta directo en la tele por DRM/KMS.
# Instalar (ver INSTALL.md):
#   sudo cp tvcast.service /etc/systemd/system/tvcast.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tvcast
[Unit]
Description=tvcast - fotos del movil a la tele
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
User=tvcast
Group=tvcast
SupplementaryGroups=video render audio
StateDirectory=tvcast
# TVCAST_WIFI_SSID y TVCAST_WIFI_PASS (para el QR de la wifi en la tele)
EnvironmentFile=-/etc/tvcast.env
ExecStart=/usr/local/bin/tvcast -addr :80 -data /var/lib/tvcast -iface wlan0 -display mpv -mpv-socket /run/tvcast/mpv.sock -mpv-args "--vo=gpu --gpu-context=drm --drm-mode=1920x1080"
RuntimeDirectory=tvcast
# Puerto 80 sin ser root (así la dirección es solo http://10.42.0.1)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
