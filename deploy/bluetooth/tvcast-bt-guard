#!/bin/sh
# tvcast-bt-guard: turns Bluetooth off by itself if the box keeps dying with it on.
#
# The box's internal Bluetooth (BCM4334, same chip as the wifi) hung the whole
# box twice. While testing it, this counts boots that did NOT end in a clean
# shutdown (a hang, a watchdog reset or a power cut). After LIMIT in a row it
# disables bluetooth and tvcast-remote and blocks the radio, so the box goes
# back to working as before (photos and wifi, no remote) until someone looks.
#
# Only active while /etc/tvcast-bt-guard.enable exists: in a house where the
# box is unplugged every night every boot looks "unclean", so it is meant for
# the test period, not forever. Installed as tvcast-bt-guard.service.
#
# Undo after it trips:
#   sudo rfkill unblock bluetooth
#   sudo systemctl enable --now bluetooth tvcast-remote
#   echo 0 | sudo tee /var/lib/tvcast-bt-guard/unclean
set -u
D=/var/lib/tvcast-bt-guard
LIMIT=${TVCAST_BT_GUARD_LIMIT:-2}
say() { echo "tvcast-bt-guard: $*"; }

case "${1:-}" in
start)
	[ -e /etc/tvcast-bt-guard.enable ] || { say "not enabled, nothing to do"; exit 0; }
	mkdir -p "$D"
	n=$(cat "$D/unclean" 2>/dev/null || echo 0)
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	if [ -e "$D/up" ]; then
		n=$((n + 1))
		echo "$n" >"$D/unclean"
		say "previous boot did not shut down cleanly ($n in a row, limit $LIMIT)"
	fi
	if [ "$n" -ge "$LIMIT" ]; then
		say "turning Bluetooth off: bluetooth and tvcast-remote disabled, radio blocked"
		systemctl disable bluetooth.service tvcast-remote.service 2>/dev/null
		systemctl --no-block stop bluetooth.service tvcast-remote.service
		rfkill block bluetooth 2>/dev/null
		rm -f /etc/tvcast-bt-guard.enable "$D/up"
		date >"$D/tripped" 2>/dev/null
		exit 0
	fi
	touch "$D/up"
	;;
stop)
	# Clean shutdown or reboot: reset the count.
	[ -e "$D/up" ] || exit 0
	rm -f "$D/up"
	echo 0 >"$D/unclean"
	;;
*)
	echo "usage: $0 start|stop" >&2
	exit 2
	;;
esac
